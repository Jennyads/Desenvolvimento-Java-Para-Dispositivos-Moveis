<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_form"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_name"
            android:textStyle="bold"
            android:textColor="#333333"
            android:textSize="14sp"
            android:paddingTop="8dp" />

        <EditText
            android:id="@+id/etNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_name"
            android:inputType="textPersonName" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_key"
            android:textStyle="bold"
            android:textColor="#333333"
            android:textSize="14sp"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/etChave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_key"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_key_type"
            android:textStyle="bold"
            android:textColor="#333333"
            android:textSize="14sp"
            android:paddingTop="12dp" />

        <Spinner
            android:id="@+id/spTipoChave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_owner"
            android:textStyle="bold"
            android:textColor="#333333"
            android:textSize="14sp"
            android:paddingTop="12dp" />

        <RadioGroup
            android:id="@+id/rgDono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbPropria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/owner_own" />

            <RadioButton
                android:id="@+id/rbTerceiro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/owner_third" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cbFavorita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_favorite"
            android:paddingTop="10dp" />

    </LinearLayout>
</ScrollView>